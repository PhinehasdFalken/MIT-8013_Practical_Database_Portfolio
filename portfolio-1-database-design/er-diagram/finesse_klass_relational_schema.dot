digraph schema {
  graph [rankdir=LR, splines=ortho, nodesep=0.5, ranksep=1.1, fontname="Helvetica",
         label="Finesse Klass – Relational Schema (generated from PostgreSQL catalogue)", labelloc=t, fontsize=18];
  node  [shape=plain, fontname="Helvetica", fontsize=10];
  edge  [arrowhead=tee, arrowtail=crow, dir=both, color="#555555"];
  address [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td bgcolor="#2f5d8a" colspan="2"><font color="white"><b>address</b></font></td></tr><tr><td align="left">PK <u>address_id</u></td><td align="left"><font color="#666666">integer</font></td></tr><tr><td align="left">FK customer_id *</td><td align="left"><font color="#666666">integer</font></td></tr><tr><td align="left"> street *</td><td align="left"><font color="#666666">varchar(150)</font></td></tr><tr><td align="left"> city *</td><td align="left"><font color="#666666">varchar(60)</font></td></tr><tr><td align="left">FK state_id *</td><td align="left"><font color="#666666">smallint</font></td></tr><tr><td align="left"> is_default *</td><td align="left"><font color="#666666">boolean</font></td></tr></table>>];
  bespoke_spec [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td bgcolor="#2f5d8a" colspan="2"><font color="white"><b>bespoke_spec</b></font></td></tr><tr><td align="left">PK FK <u>order_id</u></td><td align="left"><font color="#666666">bigint</font></td></tr><tr><td align="left">FK order_type *</td><td align="left"><font color="#666666">varchar(10)</font></td></tr><tr><td align="left"> foot_length_cm *</td><td align="left"><font color="#666666">numeric(4,1)</font></td></tr><tr><td align="left"> foot_width_cm *</td><td align="left"><font color="#666666">numeric(4,1)</font></td></tr><tr><td align="left"> leather_choice *</td><td align="left"><font color="#666666">varchar(30)</font></td></tr><tr><td align="left"> monogram</td><td align="left"><font color="#666666">varchar(6)</font></td></tr><tr><td align="left"> notes</td><td align="left"><font color="#666666">text</font></td></tr></table>>];
  category [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td bgcolor="#2f5d8a" colspan="2"><font color="white"><b>category</b></font></td></tr><tr><td align="left">PK <u>category_id</u></td><td align="left"><font color="#666666">smallint</font></td></tr><tr><td align="left"> category_name *</td><td align="left"><font color="#666666">varchar(40)</font></td></tr></table>>];
  customer [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td bgcolor="#2f5d8a" colspan="2"><font color="white"><b>customer</b></font></td></tr><tr><td align="left">PK <u>customer_id</u></td><td align="left"><font color="#666666">integer</font></td></tr><tr><td align="left"> first_name *</td><td align="left"><font color="#666666">varchar(50)</font></td></tr><tr><td align="left"> last_name *</td><td align="left"><font color="#666666">varchar(50)</font></td></tr><tr><td align="left"> email *</td><td align="left"><font color="#666666">varchar(120)</font></td></tr><tr><td align="left"> phone *</td><td align="left"><font color="#666666">varchar(20)</font></td></tr><tr><td align="left"> instagram_handle</td><td align="left"><font color="#666666">varchar(40)</font></td></tr><tr><td align="left"> created_at *</td><td align="left"><font color="#666666">timestamp</font></td></tr></table>>];
  customer_order [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td bgcolor="#2f5d8a" colspan="2"><font color="white"><b>customer_order</b></font></td></tr><tr><td align="left">PK <u>order_id</u></td><td align="left"><font color="#666666">bigint</font></td></tr><tr><td align="left">FK customer_id *</td><td align="left"><font color="#666666">integer</font></td></tr><tr><td align="left">FK address_id *</td><td align="left"><font color="#666666">integer</font></td></tr><tr><td align="left"> order_date *</td><td align="left"><font color="#666666">timestamp</font></td></tr><tr><td align="left"> order_type *</td><td align="left"><font color="#666666">varchar(10)</font></td></tr><tr><td align="left"> status *</td><td align="left"><font color="#666666">varchar(15)</font></td></tr><tr><td align="left"> total_amount *</td><td align="left"><font color="#666666">numeric(12,2)</font></td></tr></table>>];
  delivery [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td bgcolor="#2f5d8a" colspan="2"><font color="white"><b>delivery</b></font></td></tr><tr><td align="left">PK <u>delivery_id</u></td><td align="left"><font color="#666666">bigint</font></td></tr><tr><td align="left">FK order_id *</td><td align="left"><font color="#666666">bigint</font></td></tr><tr><td align="left"> courier *</td><td align="left"><font color="#666666">varchar(30)</font></td></tr><tr><td align="left"> tracking_no</td><td align="left"><font color="#666666">varchar(30)</font></td></tr><tr><td align="left"> dispatched_at</td><td align="left"><font color="#666666">timestamp</font></td></tr><tr><td align="left"> delivered_at</td><td align="left"><font color="#666666">timestamp</font></td></tr></table>>];
  order_item [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td bgcolor="#2f5d8a" colspan="2"><font color="white"><b>order_item</b></font></td></tr><tr><td align="left">PK FK <u>order_id</u></td><td align="left"><font color="#666666">bigint</font></td></tr><tr><td align="left">PK <u>line_no</u></td><td align="left"><font color="#666666">smallint</font></td></tr><tr><td align="left">FK variant_id *</td><td align="left"><font color="#666666">integer</font></td></tr><tr><td align="left"> quantity *</td><td align="left"><font color="#666666">smallint</font></td></tr><tr><td align="left"> unit_price *</td><td align="left"><font color="#666666">numeric(10,2)</font></td></tr></table>>];
  payment [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td bgcolor="#2f5d8a" colspan="2"><font color="white"><b>payment</b></font></td></tr><tr><td align="left">PK <u>payment_id</u></td><td align="left"><font color="#666666">bigint</font></td></tr><tr><td align="left">FK order_id *</td><td align="left"><font color="#666666">bigint</font></td></tr><tr><td align="left"> reference *</td><td align="left"><font color="#666666">varchar(30)</font></td></tr><tr><td align="left"> method *</td><td align="left"><font color="#666666">varchar(10)</font></td></tr><tr><td align="left"> amount *</td><td align="left"><font color="#666666">numeric(12,2)</font></td></tr><tr><td align="left"> status *</td><td align="left"><font color="#666666">varchar(10)</font></td></tr><tr><td align="left"> paid_at</td><td align="left"><font color="#666666">timestamp</font></td></tr></table>>];
  product [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td bgcolor="#2f5d8a" colspan="2"><font color="white"><b>product</b></font></td></tr><tr><td align="left">PK <u>product_id</u></td><td align="left"><font color="#666666">integer</font></td></tr><tr><td align="left">FK category_id *</td><td align="left"><font color="#666666">smallint</font></td></tr><tr><td align="left"> product_name *</td><td align="left"><font color="#666666">varchar(80)</font></td></tr><tr><td align="left"> material *</td><td align="left"><font color="#666666">varchar(40)</font></td></tr><tr><td align="left"> base_price *</td><td align="left"><font color="#666666">numeric(10,2)</font></td></tr><tr><td align="left"> bespoke_available *</td><td align="left"><font color="#666666">boolean</font></td></tr><tr><td align="left"> is_active *</td><td align="left"><font color="#666666">boolean</font></td></tr></table>>];
  product_variant [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td bgcolor="#2f5d8a" colspan="2"><font color="white"><b>product_variant</b></font></td></tr><tr><td align="left">PK <u>variant_id</u></td><td align="left"><font color="#666666">integer</font></td></tr><tr><td align="left">FK product_id *</td><td align="left"><font color="#666666">integer</font></td></tr><tr><td align="left"> size_eu *</td><td align="left"><font color="#666666">smallint</font></td></tr><tr><td align="left"> colour *</td><td align="left"><font color="#666666">varchar(20)</font></td></tr><tr><td align="left"> sku *</td><td align="left"><font color="#666666">varchar(30)</font></td></tr><tr><td align="left"> unit_price *</td><td align="left"><font color="#666666">numeric(10,2)</font></td></tr><tr><td align="left"> stock_qty *</td><td align="left"><font color="#666666">integer</font></td></tr></table>>];
  region [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td bgcolor="#2f5d8a" colspan="2"><font color="white"><b>region</b></font></td></tr><tr><td align="left">PK <u>region_id</u></td><td align="left"><font color="#666666">smallint</font></td></tr><tr><td align="left"> region_name *</td><td align="left"><font color="#666666">varchar(30)</font></td></tr></table>>];
  state [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td bgcolor="#2f5d8a" colspan="2"><font color="white"><b>state</b></font></td></tr><tr><td align="left">PK <u>state_id</u></td><td align="left"><font color="#666666">smallint</font></td></tr><tr><td align="left"> state_name *</td><td align="left"><font color="#666666">varchar(40)</font></td></tr><tr><td align="left">FK region_id *</td><td align="left"><font color="#666666">smallint</font></td></tr></table>>];
  stock_movement [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td bgcolor="#2f5d8a" colspan="2"><font color="white"><b>stock_movement</b></font></td></tr><tr><td align="left">PK <u>movement_id</u></td><td align="left"><font color="#666666">bigint</font></td></tr><tr><td align="left">FK variant_id *</td><td align="left"><font color="#666666">integer</font></td></tr><tr><td align="left"> change_qty *</td><td align="left"><font color="#666666">integer</font></td></tr><tr><td align="left"> reason *</td><td align="left"><font color="#666666">varchar(12)</font></td></tr><tr><td align="left">FK order_id</td><td align="left"><font color="#666666">bigint</font></td></tr><tr><td align="left"> moved_at *</td><td align="left"><font color="#666666">timestamp</font></td></tr></table>>];
  customer -> address;
  state -> address;
  customer_order -> bespoke_spec;
  address -> customer_order;
  customer -> customer_order;
  customer_order -> delivery;
  customer_order -> order_item;
  product_variant -> order_item;
  customer_order -> payment;
  category -> product;
  product -> product_variant;
  region -> state;
  customer_order -> stock_movement;
  product_variant -> stock_movement;
  legend [label=<<table border="0" cellborder="0"><tr><td align="left">PK = primary key (underlined), FK = foreign key, * = NOT NULL<br/>crow's foot = "many" side, bar = "one" side</td></tr></table>>];
}